{
    "name": "tagadvance/rogue-dns",
    "description": "Update DNS zones with dynamically allocated IP address, e.g. when hosting a website at home.",
    "type": "project",
    "keywords": [
        "cloudflare",
        "dns",
        "zone"
    ],
    "homepage": "https://github.com/tagadvance/rogue-dns",
    "license": "MIT",
    "authors": [
        {
            "name": "Tag",
            "email": "tagadvance+github.com@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/tagadvance/rogue-dns/issues"
    },
    "minimum-stability": "stable",
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "cloudflare/sdk": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.87",
        "guzzlehttp/psr7": "^2.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "tagadvance\\roguedns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tagadvance\\roguedns\\Test\\": "tests/"
        }
    },
    "scripts": {
        "lint": "php-cs-fixer check --diff",
        "format": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
